[Unit]
Description=market-structure oanda C4 (1D) signal job
# C4 low TF = 1D. OANDA daily candle closes at its dailyAlignment default of
# 17:00 America/New_York (tradfi_data.py sends no dailyAlignment). Fire 2min
# after close. Timezone keeps this DST-correct (21:02 UTC EDT / 22:02 UTC EST).

[Timer]
OnCalendar=*-*-* 17:02:00 America/New_York
AccuracySec=30s
Persistent=true
Unit=market-structure@oanda-c4.service

[Install]
WantedBy=timers.target
