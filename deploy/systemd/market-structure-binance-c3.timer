[Unit]
Description=market-structure binance C3 (4h) signal job
# C3 low TF = 4h. Binance H4 candles are UTC-anchored at 00/04/08/12/16/20;
# fire 30s after each close.

[Timer]
OnCalendar=*-*-* 00,04,08,12,16,20:00:30 UTC
AccuracySec=30s
Persistent=true
Unit=market-structure@binance-c3.service

[Install]
WantedBy=timers.target
