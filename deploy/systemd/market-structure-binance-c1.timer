[Unit]
Description=market-structure binance C1 (5min) signal job
# C1 low TF = 5min. Binance closes 5m candles on UTC :00/:05/:10... boundaries;
# fire 30s after close to let the exchange settle the bar.

[Timer]
OnCalendar=*-*-* *:00/5:30 UTC
AccuracySec=30s
Persistent=true
Unit=market-structure@binance-c1.service

[Install]
WantedBy=timers.target
