[Unit]
Description=market-structure scheduled signal job (%i)
Documentation=https://github.com/novakoleksiy/market-structure
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=market-structure
Group=market-structure
WorkingDirectory=/opt/market-structure
EnvironmentFile=/etc/market-structure.env
# %i is "<source>-<cluster>", e.g. "oanda-c1". The wrapper parses it,
# takes a cross-job flock, and invokes the run-source-cluster CLI.
ExecStart=/opt/market-structure/deploy/systemd/run-market-structure-job.sh %i
# A single signal run fetches market data and may paginate; cap it so a hung
# request cannot block the next candle's job indefinitely.
TimeoutStartSec=900
Nice=5

[Install]
WantedBy=multi-user.target
