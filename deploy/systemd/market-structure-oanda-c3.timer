[Unit]
Description=market-structure oanda C3 (4h) signal job
# C3 low TF = 4h. OANDA H4 is anchored to its dailyAlignment default of 17:00
# America/New_York (tradfi_data.py sends no dailyAlignment), so 4h boundaries
# fall at 17/21/01/05/09/13 NY. Timezone keeps this DST-correct year round.
# If OANDA H4 is ever observed UTC-aligned, switch to the binance-c3 expression.

[Timer]
OnCalendar=*-*-* 01,05,09,13,17,21:00:30 America/New_York
AccuracySec=30s
Persistent=true
Unit=market-structure@oanda-c3.service

[Install]
WantedBy=timers.target
