[Unit]
Description=market-structure binance C4 (1D) signal job
# C4 low TF = 1D. Binance daily candle closes 00:00 UTC; fire 2min after close
# to allow the just-closed daily bar to settle.

[Timer]
OnCalendar=*-*-* 00:02:00 UTC
AccuracySec=30s
Persistent=true
Unit=market-structure@binance-c4.service

[Install]
WantedBy=timers.target
