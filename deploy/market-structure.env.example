# Copy to /etc/market-structure.env (root:market-structure, chmod 640).
# Loaded by market-structure@.service via EnvironmentFile. These are the same
# variables main.py / tradfi_data.py / telegram_notifier.py read from the
# environment; the systemd unit does not load the repo's .env file.

# --- OANDA --------------------------------------------------------------
OANDA_API=your-oanda-api-token
# "live" for live accounts; anything else (or unset) uses practice.
OANDA_ENV=practice

# --- Telegram alerts ----------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
# Optional tuning (defaults shown):
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_DELAY_SECONDS=2

# --- Wrapper / runtime paths (optional overrides) -----------------------
# Defaults match run-market-structure-job.sh; uncomment only to override.
#MARKET_STRUCTURE_HOME=/opt/market-structure
#MARKET_STRUCTURE_DB=/var/lib/market-structure/signals.sqlite3
#MARKET_STRUCTURE_LOCK=/var/lib/market-structure/job.lock
# Absolute path to the uv binary if it is not on the service PATH.
#UV_BIN=/usr/local/bin/uv

# uv needs a writable cache/home for the service user.
UV_CACHE_DIR=/var/lib/market-structure/uv-cache
HOME=/var/lib/market-structure
